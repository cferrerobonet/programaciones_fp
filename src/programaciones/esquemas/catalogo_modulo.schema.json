{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cferrerobonet/programaciones_fp/esquemas/catalogo_modulo.schema.json",
  "title": "Módulo del catálogo",
  "description": "Un archivo de catalogo/modulos/: RA y criterios de evaluación de un módulo, con su fuente oficial (docs/MODELO_DE_DATOS.md).",
  "type": "object",
  "required": [
    "formato",
    "id",
    "codigo",
    "nombre",
    "tipo",
    "competencias_modulo",
    "ra",
    "fuente"
  ],
  "properties": {
    "formato": {
      "const": "catalogo/4"
    },
    "id": {
      "type": "string",
      "pattern": "^(\\d{4}(-[A-Z]{2,3})*|\\d{4}|CV\\d{4}|OPT-[A-Z0-9-]+)$"
    },
    "codigo": {
      "type": "string",
      "minLength": 4
    },
    "nombre": {
      "$ref": "#/$defs/texto"
    },
    "tipo": {
      "enum": [
        "propio",
        "proyecto",
        "ingles",
        "empleabilidad",
        "digitalizacion",
        "sostenibilidad",
        "autonomico",
        "optativo",
        "ambito",
        "tutoria"
      ]
    },
    "competencias_modulo": {
      "type": "object",
      "description": "Por ciclo: letras del art. 5 a las que contribuye el módulo (orientaciones pedagógicas del anexo I).",
      "patternProperties": {
        "^[A-Z]{2,3}$": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([a-zñ]|[1-9][0-9]?)$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "ra": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "n",
          "texto",
          "criterios"
        ],
        "additionalProperties": false,
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "n_boe": {
            "type": "integer",
            "minimum": 1,
            "description": "Número que imprime la fuente si no sigue la secuencia (errata)."
          },
          "texto": {
            "$ref": "#/$defs/texto"
          },
          "criterios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "letra",
                "texto"
              ],
              "additionalProperties": false,
              "properties": {
                "letra": {
                  "type": "string",
                  "pattern": "^([a-zñ]|[1-9][0-9]?)$"
                },
                "letra_boe": {
                  "type": "string",
                  "pattern": "^([a-zñ]|[1-9][0-9]?)$",
                  "description": "Letra que imprime la fuente si no sigue la secuencia (errata)."
                },
                "texto": {
                  "$ref": "#/$defs/texto"
                },
                "corregido": {
                  "$ref": "#/$defs/texto",
                  "description": "Texto que va al documento cuando el de la fuente tiene una errata (CORRECCIONES de scripts/catalogo.py). El literal se queda en «texto»."
                },
                "correccion": {
                  "type": "string",
                  "minLength": 10,
                  "description": "Motivo de la corrección."
                }
              },
              "dependentRequired": {
                "corregido": [
                  "correccion"
                ],
                "correccion": [
                  "corregido"
                ]
              }
            }
          },
          "corregido": {
            "$ref": "#/$defs/texto",
            "description": "Texto que va al documento cuando el de la fuente tiene una errata (CORRECCIONES de scripts/catalogo.py). El literal se queda en «texto»."
          },
          "correccion": {
            "type": "string",
            "minLength": 10,
            "description": "Motivo de la corrección."
          }
        },
        "dependentRequired": {
          "corregido": [
            "correccion"
          ],
          "correccion": [
            "corregido"
          ]
        }
      }
    },
    "contenidos": {
      "type": "array",
      "minItems": 1,
      "description": "Contenidos básicos del módulo por bloques, en el orden de la fuente: el apartado 4 de una programación nueva lleva una unidad por bloque (CarlosFB, 2026-10-17).",
      "items": {
        "type": "object",
        "required": [
          "titulo",
          "puntos"
        ],
        "additionalProperties": false,
        "properties": {
          "titulo": {
            "$ref": "#/$defs/texto"
          },
          "puntos": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/texto"
            }
          }
        }
      }
    },
    "contenidos_pendiente": {
      "type": "string",
      "minLength": 1,
      "description": "Por qué no hay contenidos: la fuente no se puede leer por bloques con seguridad."
    },
    "propuesta_ra_competencias": {
      "type": "object",
      "description": "Propuesta de IA (no oficial) de las competencias de cada RA, por ciclo: {sigla: {n: [letras]}}. La app la usa para rellenar una programación nueva y en «Proponer corrección con IA» (CarlosFB, 2026-10-17).",
      "patternProperties": {
        "^[A-Z]{2,4}$": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[1-9][0-9]?$": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-zñ]$"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fuente": {
      "type": "object",
      "required": [
        "norma",
        "bloque",
        "version",
        "huella",
        "comprobado"
      ],
      "additionalProperties": false,
      "properties": {
        "norma": {
          "type": "string",
          "pattern": "^(BOE-A-\\d{4}-\\d+|DOGV-C-\\d{4}-\\d+)$"
        },
        "tambien": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(BOE-A-\\d{4}-\\d+|DOGV-C-\\d{4}-\\d+)$"
          }
        },
        "bloque": {
          "type": "string",
          "minLength": 3
        },
        "version": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Publicación de la norma de la que sale el texto."
        },
        "huella": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 del texto del bloque en la fuente."
        },
        "comprobado": {
          "$ref": "#/$defs/fecha"
        }
      }
    },
    "ambito": {
      "$ref": "#/$defs/texto",
      "description": "GB: ámbito del anexo V del RD 217/2022."
    },
    "ce": {
      "type": "array",
      "minItems": 1,
      "description": "GB, ámbitos: competencias específicas con los descriptores del perfil de salida y sus criterios de evaluación (anexo V del RD 217/2022), en lugar de RA (ADR-032).",
      "items": {
        "type": "object",
        "required": [
          "n",
          "texto",
          "descriptores",
          "criterios"
        ],
        "additionalProperties": false,
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "texto": {
            "$ref": "#/$defs/texto"
          },
          "descriptores": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2,5}[0-9]$"
            }
          },
          "criterios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "n",
                "texto"
              ],
              "additionalProperties": false,
              "properties": {
                "n": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]?\\.[1-9][0-9]?$"
                },
                "texto": {
                  "$ref": "#/$defs/texto"
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "texto": {
      "type": "object",
      "description": "Texto por idioma (ADR-013): hoy solo «es».",
      "required": [
        "es"
      ],
      "properties": {
        "es": {
          "type": "string",
          "minLength": 1
        },
        "va": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "fecha": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "huella": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "ambito"
          }
        }
      },
      "then": {
        "required": [
          "ce"
        ]
      },
      "else": {
        "properties": {
          "ra": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
