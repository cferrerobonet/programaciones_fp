{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cferrerobonet/programaciones_fp/esquemas/catalogo_ciclo.schema.json",
  "title": "Ciclo del catálogo",
  "description": "Un archivo de catalogo/ciclos/: título, competencias, correspondencias con los ECP y módulos con curso y horas (docs/MODELO_DE_DATOS.md).",
  "type": "object",
  "required": [
    "formato",
    "sigla",
    "grado",
    "familia",
    "nombre",
    "titulo",
    "rd",
    "competencia_general",
    "competencias",
    "correspondencias_ecp",
    "modulos",
    "optativos_ofertados",
    "proyecto",
    "fuentes",
    "comprobado"
  ],
  "properties": {
    "formato": {
      "const": "catalogo/4"
    },
    "sigla": {
      "type": "string",
      "pattern": "^[A-Z]{2,3}$"
    },
    "grado": {
      "enum": [
        "GB",
        "GM",
        "GS"
      ]
    },
    "familia": {
      "$ref": "#/$defs/texto"
    },
    "nombre": {
      "$ref": "#/$defs/texto"
    },
    "titulo": {
      "$ref": "#/$defs/texto"
    },
    "rd": {
      "type": "object",
      "required": [
        "id",
        "nombre",
        "enlace",
        "modificado_por",
        "correcciones",
        "posteriores"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(BOE-A-\\d{4}-\\d+|DOGV-C-\\d{4}-\\d+)$"
        },
        "nombre": {
          "$ref": "#/$defs/texto"
        },
        "enlace": {
          "type": "string",
          "pattern": "^https://"
        },
        "modificado_por": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(BOE-A-\\d{4}-\\d+|DOGV-C-\\d{4}-\\d+)$"
          }
        },
        "posteriores": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "relacion",
              "texto"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "relacion": {
                "type": "string"
              },
              "texto": {
                "type": "string"
              }
            }
          }
        },
        "correcciones": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^BOE-A-\\d{4}-\\d+$"
          }
        },
        "anexo": {
          "type": "string",
          "pattern": "^[IVXL]+$",
          "description": "GB: el anexo del real decreto que trae el título (RD 127/2014)."
        }
      }
    },
    "competencia_general": {
      "$ref": "#/$defs/texto"
    },
    "competencia_general_corregida": {
      "$ref": "#/$defs/texto",
      "description": "Texto que va al documento cuando el del BOE tiene una errata (CORRECCIONES_CICLO de scripts/catalogo.py)."
    },
    "competencia_general_correccion": {
      "type": "string",
      "minLength": 10,
      "description": "Motivo de la corrección."
    },
    "competencias": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "letra",
          "texto"
        ],
        "additionalProperties": false,
        "properties": {
          "letra": {
            "type": "string",
            "pattern": "^([a-zñ]|[1-9][0-9]?)$"
          },
          "texto": {
            "$ref": "#/$defs/texto"
          },
          "numero_boe": {
            "type": "integer",
            "minimum": 1,
            "description": "Número con el que el art. 5 la imprime cuando numera en vez de usar letras (GA e IT): la 1 es la a)."
          }
        }
      }
    },
    "pendiente_competencias": {
      "type": "string",
      "minLength": 10,
      "description": "Por qué falta el dato (docs/PENDIENTE.md)."
    },
    "correspondencias_ecp": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "modulos",
          "ecp",
          "fuente"
        ],
        "additionalProperties": false,
        "properties": {
          "modulos": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^\\d{4}$"
            }
          },
          "ecp": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "codigo",
                "texto",
                "uc"
              ],
              "additionalProperties": false,
              "properties": {
                "codigo": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^ECP\\d{4}_\\d$"
                },
                "texto": {
                  "$ref": "#/$defs/texto"
                },
                "uc": {
                  "type": "string",
                  "pattern": "^UC\\d{4}_\\d$"
                },
                "equivalente": {
                  "type": "boolean",
                  "description": "UC suprimida: ECP equivalente según el RD 532/2025."
                },
                "pendiente": {
                  "type": "string",
                  "minLength": 10,
                  "description": "Por qué falta el dato (docs/PENDIENTE.md)."
                },
                "uc_boe": {
                  "type": "string",
                  "pattern": "^UC\\d{4}_\\d$",
                  "description": "UC que imprime la fuente cuando es una errata (ERRATAS_UC de scripts/catalogo.py)."
                },
                "correccion": {
                  "type": "string",
                  "minLength": 10,
                  "description": "Motivo de la corrección de la UC."
                }
              },
              "dependentRequired": {
                "uc_boe": [
                  "correccion"
                ],
                "correccion": [
                  "uc_boe"
                ]
              }
            }
          },
          "fuente": {
            "type": "string",
            "pattern": "^(BOE-A-\\d{4}-\\d+|DOGV-C-\\d{4}-\\d+)$"
          }
        }
      }
    },
    "modulos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "codigo",
          "modulo",
          "nombre",
          "curso",
          "h_sem",
          "h_anuales",
          "tipo"
        ],
        "additionalProperties": false,
        "properties": {
          "codigo": {
            "type": "string",
            "pattern": "^(\\d{4}p?|\\d{7}|\\d{4}[A-Z]\\d{2}|CVOP[MS]\\d{3}|CV\\d{4}|TU0[12]CF)$"
          },
          "modulo": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(\\d{4}(-[A-Z]{2,3})*|\\d{4}|CV\\d{4}|OPT-[A-Z0-9-]+)$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Archivo de catalogo/modulos/ con sus RA (null: optativo o pendiente)."
          },
          "nombre": {
            "$ref": "#/$defs/texto"
          },
          "curso": {
            "enum": [
              1,
              2
            ]
          },
          "h_sem": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "h_anuales": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "tipo": {
            "enum": [
              "propio",
              "proyecto",
              "ingles",
              "empleabilidad",
              "digitalizacion",
              "sostenibilidad",
              "autonomico",
              "optativo",
              "ambito",
              "tutoria"
            ]
          },
          "pendiente": {
            "type": "string",
            "minLength": 10,
            "description": "Por qué falta el dato (docs/PENDIENTE.md)."
          },
          "partes": {
            "type": "array",
            "minItems": 1,
            "description": "GB, Comunicación y Ciencias Sociales: materias del ámbito con sus horas (anexo III-B del Decreto 117/2025 en la redacción del Decreto 95/2026).",
            "items": {
              "type": "object",
              "required": [
                "nombre",
                "h_sem",
                "h_anuales"
              ],
              "additionalProperties": false,
              "properties": {
                "nombre": {
                  "$ref": "#/$defs/texto"
                },
                "h_sem": {
                  "type": "integer",
                  "minimum": 1
                },
                "h_anuales": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "optativos_ofertados": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "codigo",
          "modulo",
          "nombre",
          "curso",
          "fuente"
        ],
        "additionalProperties": false,
        "properties": {
          "codigo": {
            "type": "string"
          },
          "modulo": {
            "type": "string",
            "pattern": "^(\\d{4}(-[A-Z]{2,3})*|\\d{4}|CV\\d{4}|OPT-[A-Z0-9-]+)$"
          },
          "nombre": {
            "$ref": "#/$defs/texto"
          },
          "curso": {
            "enum": [
              1,
              2
            ]
          },
          "fuente": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "proyecto": {
      "type": [
        "string",
        "null"
      ]
    },
    "fuentes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "comprobado": {
      "$ref": "#/$defs/fecha"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "texto": {
      "type": "object",
      "description": "Texto por idioma (ADR-013): hoy solo «es».",
      "required": [
        "es"
      ],
      "properties": {
        "es": {
          "type": "string",
          "minLength": 1
        },
        "va": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "fecha": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "huella": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "dependentRequired": {
    "competencia_general_corregida": [
      "competencia_general_correccion"
    ],
    "competencia_general_correccion": [
      "competencia_general_corregida"
    ]
  }
}
