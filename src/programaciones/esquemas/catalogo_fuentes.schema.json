{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cferrerobonet/programaciones_fp/esquemas/catalogo_fuentes.schema.json",
  "title": "Fuentes del catálogo",
  "description": "catalogo/fuentes.yaml: cada documento oficial leído, con su huella SHA-256 (la del archivo descargado) y la fecha de consulta.",
  "type": "object",
  "required": [
    "formato",
    "fuentes"
  ],
  "properties": {
    "formato": {
      "const": "catalogo/2"
    },
    "fuentes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tipo",
          "titulo",
          "url",
          "enlace",
          "publicado",
          "huella",
          "consultado"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(BOE-A-\\d{4}-\\d+|DOGV-C-\\d{4}-\\d+)$"
          },
          "tipo": {
            "enum": [
              "boe",
              "dogv"
            ]
          },
          "titulo": {
            "$ref": "#/$defs/texto"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "enlace": {
            "type": "string",
            "pattern": "^https://"
          },
          "publicado": {
            "$ref": "#/$defs/fecha"
          },
          "huella": {
            "$ref": "#/$defs/huella"
          },
          "consultado": {
            "$ref": "#/$defs/fecha"
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "texto": {
      "type": "object",
      "description": "Texto por idioma (ADR-013): hoy solo «es».",
      "required": [
        "es"
      ],
      "properties": {
        "es": {
          "type": "string",
          "minLength": 1
        },
        "va": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "fecha": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "huella": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
