{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cferrerobonet/programaciones_fp/esquemas/catalogo_version.schema.json",
  "title": "Versión del catálogo",
  "description": "catalogo/version.yaml (ADR-027): la versión AAAA.MM.DD[.n] que guarda cada programación, su fecha y la huella SHA-256 del contenido del catálogo (todos sus archivos salvo este). La escribe scripts/catalogo.py construir o version.",
  "type": "object",
  "required": [
    "formato",
    "version",
    "fecha",
    "huella"
  ],
  "properties": {
    "formato": {
      "const": "catalogo/3"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}(\\.\\d{1,3})?$"
    },
    "fecha": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "huella": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
